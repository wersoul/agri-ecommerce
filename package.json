{
  "name": "agri-ecommerce",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "preview": "next build && next-on-pages && wrangler pages dev .vercel/output/static",
    "deploy": "next build && next-on-pages && wrangler pages deploy .vercel/output/static --project-name=agri-ecommerce",
    "cf:dev": "next dev",
    "cf:preview": "next build && next-on-pages && wrangler pages dev .vercel/output/static",
    "postbuild": "node scripts/post-build.js",
    "db:local": "wrangler d1 execute agri-ecommerce-db --local --file=./migrations/0001_initial.sql",
    "db:remote": "wrangler d1 execute agri-ecommerce-db --remote --file=./migrations/0001_initial.sql",
    "db:seed:local": "wrangler d1 execute agri-ecommerce-db --local --file=./migrations/0002_seed.sql",
    "db:seed:remote": "wrangler d1 execute agri-ecommerce-db --remote --file=./migrations/0002_seed.sql",
    "admin:create": "node scripts/create-admin.js admin admin123 admin@agri-shop.com"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "jose": "^5.6.3",
    "next": "14.2.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.10.0",
    "@cloudflare/workers-types": "^4.20240620.0",
    "@esbuild/darwin-arm64": "^0.28.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.30",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "wrangler": "^3.65.0"
  }
}
